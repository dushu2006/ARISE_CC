# ARISE Local Configuration (EXAMPLE)
# Copy this file to config.local.yaml and fill in your values
# This file is gitignored - never commit secrets!

version: "1.2.0"

# Environment override
# environment: "development"
# debug: true

# Database override (e.g., for local PostgreSQL)
# database:
#   url: "postgresql+asyncpg://user:pass@localhost:5432/arise_local"

# Redis override
# redis:
#   url: "redis://localhost:6379/2"

